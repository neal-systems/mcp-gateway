# Copy to backend.hcl and replace <account_id> with the value printed by the
# bootstrap `state_bucket` output. backend.hcl is gitignored.
#
#   terraform init -backend-config=backend.hcl

bucket = "mcpgw-demo-tfstate-<account_id>"
key    = "demo/terraform.tfstate"
region = "us-east-2"

# S3 native state locking, Terraform >= 1.10. This replaces the DynamoDB lock
# table entirely: no table to create, and nothing to pay for.
use_lockfile = true
encrypt      = true
