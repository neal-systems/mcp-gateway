# Copy this file to config.env and replace every YOUR_ value.
GATEWAY_DOMAIN=gateway.example.com
GATEWAY_BASE_URL=https://gateway.example.com
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# Create a GitHub OAuth App with callback URL:
# https://gateway.example.com/auth/callback
GITHUB_CLIENT_ID=YOUR_GITHUB_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_OAUTH_CLIENT_SECRET

# Leave unset to generate-once into GATEWAY_JWT_SIGNING_KEY_FILE, or set a
# persistent random value at least 32 characters long.
GATEWAY_JWT_SIGNING_KEY=

# Root of persistent state (created 0700). client_storage/ and the signing
# key file live under here unless the two overrides below are set.
GATEWAY_STATE_DIR=/data/state

# Explicit override only; normally derived as $GATEWAY_STATE_DIR/client_storage.
GATEWAY_CLIENT_STORAGE=

# Explicit override only; normally derived as $GATEWAY_STATE_DIR/jwt_signing_key.
GATEWAY_JWT_SIGNING_KEY_FILE=

# Image digest or git sha for this release; used only as telemetry service.version.
GATEWAY_RELEASE_ID=dev

# Set to "not_ready" only for the deliberate failed-release drill; never affects auth.
GATEWAY_FAULT_INJECT=

# GitHub numeric user IDs, comma separated. Names are intentionally unsupported.
GATEWAY_OPERATOR_GITHUB_IDS=YOUR_GITHUB_ID
GATEWAY_VIEWER_GITHUB_IDS=

# The public copy reads only this shipped example file.
GATEWAY_SAMPLE_DATA=/app/sample_data.json
